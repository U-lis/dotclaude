#!/usr/bin/env bash
# Phase 2 TEST matrix content checks. Usage: bash phase2-check.sh.log <tree>; the helper phase2-cols.py.log sits beside it.
HERE=$(cd "$(dirname "$0")" && pwd)
COLS="$HERE/phase2-cols.py.log"
cd "$1" || exit 2
E=claude_works/2026_11_06-reviewer-redesign/EVIDENCE.md
ok=0; bad=0
t() { if eval "$2" >/dev/null 2>&1; then echo "PASS $1"; ok=$((ok+1)); else echo "FAIL $1"; bad=$((bad+1)); fi; }
sec() { awk '/^## Evidence$/{f=1;next} /^## /{f=0} f' commands/_contract.md; }
# Row 1
t "R1 template header 8 columns" "grep -qxF '| Stage | Behavior | Data setup | Command or action | Result summary | Raw output path | Commit | Author |' templates/EVIDENCE.md"
for s in '## coder' '## orchestrator (run stages)' '## verification session' '## reviewer'; do t "R1 section $s" "grep -qxF '$s' templates/EVIDENCE.md"; done
t "R1 contract names template path" "sec | grep -qF '\${CLAUDE_PLUGIN_ROOT}/templates/EVIDENCE.md'"
t "R1 lint exit 0" "bash scripts/lint-prompts.sh"
# Row 2
t "R2 no command or raw output is not evidence" "sec | grep -qiE 'without a command.*raw output.*not evidence'"
# Row 3
t "R3 commit differs from head is stale" "sec | grep -qiE 'commit.*(differs|other than).*head.*stale'"
# Row 4
for i in 1 2 3 4 5 6; do t "R4 E$i row has command, evidence/ raw path, commit 6b84393, author" "grep -E '^\| (local|remote) \| E$i[ :]' $E | grep -F 'reviewer-redesign/evidence/' | grep -qE '\| 6b84393 \| [a-z]'"; done
t "R4 E3 substitute-tool caveat" "grep -E '^\| local \| E3' $E | grep -qi 'Notion or Jira call itself was not observed'"
# Row 5
t "R5 coder-base refers to Contract: Evidence (>=3)" "[ \$(grep -c 'Contract: Evidence' commands/_coder-base.md) -ge 3 ]"
t "R5 start-new Run stages refers" "awk '/^## Run stages/{f=1;next} /^## /{f=0} f' commands/start-new.md | grep -q 'Contract: Evidence'"
t "R5 no restating in producers" "! grep -qiE 'not evidence|stale' commands/_coder-base.md commands/start-new.md"
t "R5 Documents row lists EVIDENCE.md" "grep -E '^\| Documents \|' commands/_contract.md | grep -q 'EVIDENCE.md'"
# Row 6 (follow-up rule 1: raw output location)
t "R6 contract: .log under {doc_dir}/evidence/, round dir for reviewer, no temp path, repo-relative" "sec | grep -F '{working_directory}/{doc_dir}/evidence/' | grep -F '.log' | grep -i 'round directory' | grep -i 'temporary or session path' | grep -qi 'relative to the repository root'"
t "R6 every raw output cell is repo-relative under evidence/ and exists" "[ -f $E ] && python3 -I "$COLS" $E | awk -F'\t' '{n=split(\$2,a,\", \"); for(i=1;i<=n;i++){g=a[i]; gsub(/\`/,\"\",g); if(g !~ /^claude_works\/2026_11_06-reviewer-redesign\/evidence\/[^ ]+\.log\$/){print \"bad \" g; exit 1}; if(system(\"test -f \" g)!=0){print \"missing \" g; exit 1}}}'"
t "R6 no /tmp in any raw output cell" "[ -f $E ] && ! python3 -I "$COLS" $E | cut -f2 | grep -q /tmp"
# Row 7 (follow-up rule 2: uncommitted phase rows)
t "R7 contract: phase {k} (uncommitted), orchestrator replaces after phase commit" "sec | grep -F 'phase {k} (uncommitted)' | grep -qiE 'after the phase commit.*orchestrator replaces'"
t "R7 coder-base commit column refers to Contract: Evidence" "grep -i 'commit column' commands/_coder-base.md | grep -q 'Contract: Evidence'"
t "R7 coder-base does not restate the rule" "! grep -qF 'phase {k} (uncommitted)' commands/_coder-base.md"
t "R7 phase 2 rows carry phase 2 (uncommitted)" "[ \$(python3 -I "$COLS" $E | grep -c \$'\tphase 2 (uncommitted)\t') -ge 4 ]"
# Review fixes
t "R8 Commits phase row lists EVIDENCE.md and evidence/*.log" "grep -E '^\| After code-validator returns PASS for a phase \|' commands/_contract.md | grep -F 'EVIDENCE.md' | grep -qF 'evidence/*.log'"
t "R8 contract names the commit that carries the replaced hash" "sec | grep -F 'phase {k} (uncommitted)' | grep -qiE 'next phase.s commit.*CHANGELOG/README'"
t "R8 code.md and start-new refer to Contract: Evidence at the phase commit" "grep -E '^6\. Commit' commands/code.md | grep -q 'Contract: Evidence' && grep -E '^ *- Commit the phase' commands/start-new.md | grep -q 'Contract: Evidence'"
t "R9 secrets are redacted before raw output is saved" "sec | grep -iE 'credentials.*tokens.*cookies.*env dumps' | grep -qi 'redacted'"
t "R10 phase 2 rows exist and no Command cell contains /tmp" "[ \$(python3 -I \"\$COLS\" $E | grep -vc '^E[0-9]') -ge 4 ] && ! python3 -I \"\$COLS\" $E | grep -v '^E[0-9]' | cut -f4 | grep -q /tmp"
echo "passed=$ok failed=$bad"; [ $bad = 0 ]
